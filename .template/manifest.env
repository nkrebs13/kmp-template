# The template's own identity: every token setup.sh renames, and nothing else. Plain KEY=value
# that bash 3.2 can source (no spaces around '=', quote values that contain spaces).
#
# Package mapping. setup.sh replaces all tokens in one pass, longest token first, so a value it
# writes is never rewritten by a later token:
#   TEMPLATE_BUNDLE_ID     com.template.ios                  -> --bundle-id
#   TEMPLATE_APP_PACKAGE   com.template.android              -> --package           (androidApp)
#   TEMPLATE_PACKAGE_ROOT  com.template.<module>             -> --package.<module>  (shared, desktop,
#                                                                                    baselineprofile)
# The slash forms (com/template/android, com/template) map the same way, which also moves every
# */kotlin/com/template/** source directory.
#   TEMPLATE_DISPLAY_NAME  "KMP Template"                    -> --display-name      (Android label,
#                                                               iOS display name, desktop window title)
#   TEMPLATE_NAME          KmpTemplate                       -> --name              (rootProject.name,
#                                                               logger tag, desktop installer name)
TEMPLATE_REPO=nkrebs13/kmp-template
TEMPLATE_SLUG=kmp-template
TEMPLATE_NAME=KmpTemplate
TEMPLATE_DISPLAY_NAME="KMP Template"
TEMPLATE_PACKAGE_ROOT=com.template
TEMPLATE_APP_PACKAGE=com.template.android
TEMPLATE_BUNDLE_ID=com.template.ios

# Removed by --no-desktop, in addition to every "region desktop" ... "endregion desktop" block.
DESKTOP_PATHS="desktopApp shared/src/jvmMain shared/src/jvmTest"
