* text=auto eol=lf
# Windows scripts are stored exactly as written, with CRLF. Gradle's wrapper task and Dependabot's
# wrapper updates commit gradlew.bat with CRLF; normalizing it would show a phantom change after
# every wrapper update (and fail setup.sh's clean-tree check).
*.bat -text
*.jar binary
*.png binary
*.jpg binary
*.ico binary
